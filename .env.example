# Hugging Face — necessário para o fine-tuning (issues #3/#4).
# Precisa de permissão de WRITE para publicar o adapter LoRA no Hub.
HF_TOKEN=your_hugging_face_token_here

# Repositório do adapter LoRA publicado (ex.: usuario/hospital-assistant-llama32-3b-lora).
# Lido por src/hospital_assistant/llm/model_loader.py em runtime: sem isso o app
# roda com o MockLLM (stand-in determinístico) em vez do modelo fine-tunado.
HF_ADAPTER_REPO=

# Geração dos dados sintéticos do hospital fictício (issue #2). Basta UMA das duas.
# Groq tem precedência no código — free tier aguenta o volume da geração.
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
