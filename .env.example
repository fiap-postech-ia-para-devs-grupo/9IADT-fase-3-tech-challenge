# Hugging Face — necessário para o fine-tuning (issues #3/#4).
# Precisa de permissão de WRITE para publicar o adapter LoRA no Hub.
HF_TOKEN=your_hugging_face_token_here

# Repositório do adapter LoRA publicado (ex.: usuario/hospital-assistant-llama32-3b-lora).
# Lido em runtime por src/hospital_assistant/llm/model_loader.py. Preenchê-lo é
# declarar que se quer o modelo treinado: se o ambiente não puder carregá-lo, o
# app recusa abrir em vez de responder com o stand-in sem avisar.
HF_ADAPTER_REPO=

# Libera a interface sem o modelo treinado, com respostas de demonstração.
# Necessário para rodar em máquina sem placa de vídeo: a carga em 4-bit exige
# CUDA. É opt-in de propósito — a degradação automática já colocou uma demo no
# ar com o gerador de mentira, e o único sinal foi um aviso no meio do log.
MODO_DEMONSTRACAO=false

# Geração dos dados sintéticos do hospital fictício (issue #2). Basta UMA das duas.
# Groq tem precedência no código — free tier aguenta o volume da geração.
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
