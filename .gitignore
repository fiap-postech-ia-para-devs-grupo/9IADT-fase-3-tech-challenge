# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# Distribution / packaging
.Python
build/
dist/
*.egg-info/

# Unit test / coverage reports
htmlcov/
.pytest_cache/
.coverage
.coverage.*
.cache

# Jupyter Notebook
.ipynb_checkpoints

# Environments
.env
.env.*
!.env.example
.venv
env/
venv/

# Ruff
.ruff_cache/

# mypy / pyright
.mypy_cache/

# OS / editor
.DS_Store
.idea/

# Project-specific mock/derived data — regenerate via seed_mock_data.py / ingest.py
data/patients_mock.db
data/audit.db
# Estado de execucao: decisoes de validacao e base que cresce com os atendimentos.
data/decisoes_validacao.json
data/base_conhecimento.json
data/medicos.json
data/laudos.json
clinical_audit.log
clinical_audit.jsonl
dataprep.log
data/chroma/*
!data/chroma/.gitkeep
# Os splits de treino/validação SÃO versionados: PubMedQA e MedQuAD vêm do
# Hugging Face sem revisão fixada, então uma regeneração futura pode não sair
# idêntica — e sem o arquivo no Git não haveria registro de sobre o que o
# adapter publicado foi de fato treinado. São ~1,3MB.
data/processed/*
!data/processed/.gitkeep
!data/processed/train.jsonl
!data/processed/val.jsonl

# Model artifacts — only the adapter reference lives in results/, not weights
*.safetensors
*.bin
*.gguf

# Streamlit
.streamlit/secrets.toml

# Logs de execução local do Streamlit
streamlit.log
portal.log
